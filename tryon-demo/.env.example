# ── Live AI try-on (optional) ────────────────────────────────────────────────
# Copy this file to .env.local and fill in DECART_API_KEY to switch from
# Simulation to live. With no key the demo runs in Simulation mode — no key,
# no account, nothing leaves the browser tab.
#
# Everything here is read on the SERVER only. Never prefix with NEXT_PUBLIC_.
# The browser only ever receives a ~60-second ephemeral client token minted by
# /api/token; the permanent key never reaches client code.

# Permanent Decart API key (starts with dct_). Get one at https://platform.decart.ai
DECART_API_KEY=

# live | sim. Optional. Default: live when a key is set, otherwise sim.
# Set to sim to force Simulation even if a key is present (no per-second billing).
TRYON_MODE=

# Realtime model. Pinned on purpose: "latest" would silently change what you test.
# Allowed: lucy-vton-3.6 (default), lucy-vton-3.5, lucy-vton-latest.
TRYON_MODEL=lucy-vton-3.6

# Cost guardrails while testing (seconds). Applied twice: the minted token carries a
# hard server-side session cap, and the panel ends the session client-side at the same
# point. 0 disables both. Default 180.
TRYON_MAX_SESSION_SECONDS=180

# Optional. 1 = speed:"fast" (lower connect latency, billed 2x). Default off.
TRYON_FAST=

# ── Photo mode (optional) ─────────────────────────────────────────────────────
# Your own still-image render server (server/tryon_server.py, FASHN VTON 1.5 on your GPU). When set, the live
# panel gets a "See it properly" button that sends ONE camera photo + the garment image there and shows the result.
# Not a secret, but it is your LAN address: keep it in .env.local.
TRYON_PHOTO_URL=
